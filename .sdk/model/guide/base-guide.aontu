# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 5
  metrics: count: path: 6
  metrics: count: method: 6

  entity: dataset: {
    path: "/data/shelves.json": {
      op: list: method: *GET
      op: list: transform: res: *("`body.rows`")|top
    }
  }

  entity: index_stat: {
    path: "/api/stats": {
      op: load: method: *GET
    }
  }

  entity: lab: {
    path: "/data/lab.json": {
      op: list: method: *GET
    }
  }

  entity: shelf: {
    path: "/api/shelves": {
      op: list: method: *GET
      op: list: transform: res: *("`body.shelves`")|top
    }
    path: "/api/shelves/{id}": {
      op: load: method: *GET
    }
  }

  entity: traffic: {
    path: "/api/traffic": {
      op: list: method: *GET
    }
  }

}